# Postgres (Railway sets it automatically when you add a database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/karma
# Telegram bot token: used to verify Mini App initData. Empty = verification off (local dev only)
BOT_TOKEN=
# Token for the admin panel (X-Admin-Token header). Empty = admin endpoints disabled
ADMIN_TOKEN=
NODE_ENV=development
PORT=3000
